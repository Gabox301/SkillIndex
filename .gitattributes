# Ensure registry files use LF line endings (prevents hash mismatch on Windows checkout via core.autocrlf)
skills-registry/** text eol=lf
skills-registry/index.json text eol=lf

# Binaries must never be line-normalized (normalization corrupts bytes and hashes)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# General: keep LF for code and registry (prevents Windows CRLF mismatches)
*.ts text eol=lf
*.rs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.toml text eol=lf
*.lock text eol=lf
LICENSE text eol=lf

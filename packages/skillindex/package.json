{
  "name": "skillindex",
  "version": "2.1.0",
  "description": "Detecta automáticamente tu stack tecnológico e instala las mejores skills de agentes IA para tu proyecto.",
  "keywords": [
    "agent",
    "ai",
    "auto",
    "claude",
    "cli",
    "copilot",
    "cursor",
    "detect",
    "skills"
  ],
  "homepage": "https://skillindex.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gabox301/SkillIndex.git"
  },
  "bugs": {
    "url": "https://github.com/Gabox301/SkillIndex/issues"
  },
  "license": "MIT",
  "author": "gabriel ortega",
  "bin": {
    "skillindex": "index.mjs"
  },
  "files": [
    "index.mjs",
    "index.ts",
    "dist/",
    "skills-registry/index.json"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "bun test",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "validate:registry": "bun run scripts/validate-registry.ts",
    "prepublishOnly": "bun run check && bun run lint && bun run test && bun run build && bun run validate:registry",
    "sync:skills": "bun run scripts/sync-skills.ts",
    "fendo:check": "bun run scripts/fendo.ts"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@types/node": "26.4.1",
    "oxlint": "1.81.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}

{
  "name": "skillindex",
  "version": "3.0.0",
  "description": "Detecta automáticamente tu stack tecnológico e instala las mejores skills de agentes IA para tu proyecto.",
  "keywords": [
    "agent",
    "ai",
    "auto",
    "cli",
    "detect",
    "skills"
  ],
  "homepage": "https://skillindex.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gabox301/SkillIndex.git"
  },
  "bugs": {
    "url": "https://github.com/Gabox301/SkillIndex/issues"
  },
  "license": "MIT",
  "author": "gabriel ortega",
  "bin": {
    "skillindex": "index.mjs"
  },
  "files": [
    "index.mjs",
    "index.ts",
    "postinstall.mjs",
    "dist/",
    "skills-registry/index.json"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "test": "cargo test --manifest-path Cargo.toml",
    "test:node": "bun test",
    "check": "tsc --noEmit",
    "lint": "oxlint",
    "validate": "cargo run --bin validate-registry",
    "regenerate": "cargo run --bin regenerate-index",
    "prepublish": "bun run check && bun run lint && cargo test --manifest-path Cargo.toml && bun run build && cargo run --bin validate-registry",
    "sync": "cargo run --bin sync-skills --",
    "fendo": "cargo run --bin fendo",
    "postinstall": "node postinstall.mjs"
  },
  "packageManager": "bun@1.4.0",
  "devDependencies": {
    "@types/node": "26.4.1",
    "oxlint": "1.81.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.6.0"
  }
}
